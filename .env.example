# Optional LLM layer (Phase 5: semantic reasoning + explanation prose).
# The pipeline works fully without a key; these only enable the enhancement.
LLM_ENABLED=true

# OpenAI-compatible endpoint. OpenRouter default.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Any OpenAI-compatible provider works here:
#   OpenRouter: keep base URL above, key from openrouter.ai
#   Groq:       https://api.groq.com/openai/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your_key_here

# Model identifier (OpenRouter style). Free tier examples:
LLM_MODEL=deepseek/deepseek-chat-v3-0324:free