# ---- Supabase (backend / service side) ----
# Project URL and keys from Supabase Dashboard → Project Settings → API.
# Frontend uses VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY (frontend/.env).
# Backend uses SUPABASE_SECRET_KEY (service role) for persistence/auth/storage.
SUPABASE_URL=https://bfseljhjwylapgrocvzm.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# ---- Optional LLM layer (Phase 5: semantic reasoning + explanation prose). ----
# The pipeline works fully without a key; these only enable the enhancement.
LLM_ENABLED=true

# OpenAI-compatible endpoint. OpenRouter default.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Any OpenAI-compatible provider works here:
#   OpenRouter: keep base URL above, key from openrouter.ai/keys
#   Groq:       https://api.groq.com/openai/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your_key_here

# Model identifier (OpenRouter style). Free tier examples (list via openrouter.ai/api/v1/models):
# Current working free pick:
LLM_MODEL=minimax/minimax-m3:free
# Alternatives if rate-limited: nvidia/nemotron-3-super-120b-a12b:free, google/gemma-4-31b-it:free